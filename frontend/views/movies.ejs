<%- include('partials/header') %>

<!-- Movies Hero Header -->
<header class="bg-dark text-white text-center py-5">
  <div class="container py-4">
    <h1 class="display-4 fw-bold">Trending Movies</h1>
    <p class="lead text-muted mb-0">Explore our curated collection of critically acclaimed films.</p>
  </div>
</header>

<!-- Movies Catalog Grid -->
<main class="container my-5 py-3 flex-grow-1">
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    
    <% movies.forEach(movie => { %>
      <div class="col">
        <div class="card h-100 border-0 shadow-sm transition-card">
          <!-- Movie Poster Cover Image -->
          <img src="<%= movie.image %>" class="card-img-top object-fit-cover" style="height: 300px;" alt="<%= movie.title %> Poster">
          
          <div class="card-body d-flex flex-column">
            <!-- Title & Metadata Grid -->
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title fw-bold mb-0 text-truncate me-2" style="max-width: 75%;"><%= movie.title %></h5>
              <span class="badge bg-warning text-dark fw-bold">⭐ <%= movie.rating %></span>
            </div>
            
            <!-- Category Badges / Tags -->
            <div class="mb-3">
              <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill"><%= movie.genre %></span>
              <span class="badge bg-light text-dark border"><%= movie.year %></span>
            </div>
            
            <!-- Synopsis -->
            <p class="card-text text-muted small flex-grow-1"><%= movie.description %></p>
            
            <!-- Action Button -->
            <div class="mt-3">
              <a href="#" class="btn btn-outline-primary btn-sm w-100 fw-semibold">View Details</a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>

  </div>
</main>

<%- include('partials/footer') %>
